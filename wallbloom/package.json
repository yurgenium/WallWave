{
  "name": "wallbloom",
  "version": "0.4.7",
  "private": true,
  "type": "module",
  "description": "Local wallpaper recommendations for Windows",
  "author": "WallWave contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.mjs",
    "test": "node --test core.test.mjs automation.test.mjs framing.test.mjs integration.test.mjs plan-integration.test.mjs desktop/status.test.cjs desktop/storage.test.cjs resources.test.mjs download-controls.test.mjs network-retry.test.mjs sprintf-security.test.cjs orientation.test.mjs wallpaper-titles.test.mjs",
    "check": "node --check server.mjs && node --check desktop/main.cjs && node --check public/app.js",
    "icons": "node tools/create-icons.mjs",
    "build:win": "node tools/create-icons.mjs && electron-builder --win nsis --x64",
    "build:dir": "node tools/create-icons.mjs && electron-builder --win dir --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.wallbloom.desktop",
    "productName": "WallWave",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "public/**",
      "server.mjs",
      "core.mjs",
      "library.mjs",
      "network.mjs",
      "providers.mjs",
      "windows.mjs",
      "ai-worker.mjs",
      "LICENSE",
      "package.json",
      "automation.mjs",
      "archive.mjs",
      "monitor-native.cs",
      "framing.mjs",
      "resources.mjs",
      "orientation.mjs"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icons/app.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "script": "desktop/deploy.nsi",
      "artifactName": "WallWave-${version}-Windows-x64.exe"
    }
  }
}
