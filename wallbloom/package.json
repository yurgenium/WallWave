{
  "name": "wallbloom",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Local wallpaper recommendations for Windows",
  "author": "WallWave contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.mjs",
    "test": "node --test *.test.mjs *.test.cjs desktop/*.test.cjs",
    "check": "node tools/check-syntax.mjs",
    "icons": "node tools/create-icons.mjs",
    "build:win": "node tools/create-icons.mjs && electron-builder --win nsis --x64",
    "build:dir": "node tools/create-icons.mjs && electron-builder --win dir --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.wallbloom.desktop",
    "productName": "WallWave",
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "public/**",
      "server.mjs",
      "profiles.mjs",
      "library-features.mjs",
      "diagnostics.mjs",
      "core.mjs",
      "library.mjs",
      "library-cleanup.mjs",
      "network.mjs",
      "providers.mjs",
      "windows.mjs",
      "ai-worker.mjs",
      "LICENSE",
      "package.json",
      "automation.mjs",
      "archive.mjs",
      "monitor-native.cs",
      "framing.mjs",
      "resources.mjs",
      "orientation.mjs",
      "catalog-providers.mjs",
      "persistence.mjs",
      "!**/*.map",
      "!**/*.d.ts",
      "!desktop/**/*.test.cjs",
      "!desktop/deploy.nsi",
      "!desktop/deployment-readme.md",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/{darwin,linux}/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/@huggingface/transformers/{src,types}/**",
      "!**/node_modules/@huggingface/transformers/dist/!(transformers.node.mjs|transformers.node.cjs)",
      "visual-ai.mjs",
      "ai-session.mjs",
      "art-providers.mjs",
      "search-profile.mjs",
      "download-queue.mjs"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icons/app.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "script": "desktop/deploy.nsi",
      "artifactName": "WallWave-${version}-Windows-x64.exe"
    }
  }
}
